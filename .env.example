# TypeSafe Jev (System One)
# Create a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional. Defaults to jev-latest. Pin a version with e.g. jev-1.13.0
TYPESAFE_MODEL=jev-latest
# Optional override of https://api.typesafe.ai
# TYPESAFE_BASE_URL=

# LLM baseline via OpenRouter (OpenAI-compatible)
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Defaults to openai/gpt-4o-mini (provider-prefixed OpenRouter id)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Fallback if OPENROUTER_API_KEY is unset
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Defaults to https://openrouter.ai/api/v1 ; override only if you use another gateway
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://github.com/SarathChandraBellam/jev-vs-llm-ticket-router
# OPENROUTER_X_TITLE=jev-vs-llm-ticket-router
