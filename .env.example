# TypeSafe Jev (System One)
# Create a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional. Defaults to jev-latest. Pin a version with e.g. jev-1.13.0
TYPESAFE_MODEL=jev-latest
# Optional override of https://api.typesafe.ai
# TYPESAFE_BASE_URL=

# OpenAI-compatible LLM baseline
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional. Point at any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
